{
  "name": "@ensdomains/dnsprovejs",
  "version": "1.0.1",
  "description": "A library to generate chains of trust proving DNS records via DNSSEC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@noble/hashes": "^2",
    "@scure/base": "^2",
    "@types/dns-packet": "^5.6.5",
    "buffer": "^6.0.3",
    "dns-packet": "^5.6.1",
    "typescript-logging": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22",
    "typescript": "^5"
  },
  "scripts": {
    "test": "node --import ./tests/register.ts --test 'tests/*.test.ts'",
    "build": "tsc",
    "lint": "biome check",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensdomains/dnsprovejs.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ensdomains/dnsprovejs/issues"
  },
  "homepage": "https://github.com/ensdomains/dnsprovejs#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.11.2"
    },
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    }
  }
}
